---
export const prerender = false;

import BaseLayout from "@/components/components/BaseLayout.astro";
import CustomPageBlocks from "@/components/sections/CustomPageBlocks.astro";
import { customPageService } from "@/features/custom-pages/services/custom-page.service";
import { siteConfig } from "@/lib/config/site";

const rawSlug = Astro.params.slug ?? "";
const slug = rawSlug.replace(/^\/+/, "").replace(/\/+$/, "").toLowerCase();

if (!slug) {
  return new Response("Not found", { status: 404 });
}

const page = await customPageService.getBySlug("sr-cyrl", slug);

if (!page || page.status !== "published") {
  return new Response("Not found", { status: 404 });
}
---

<BaseLayout
  title={`${page.title} | ${siteConfig.name}`}
  description={page.description ?? page.title}
  locale="sr-cyrl"
  canonicalPath={Astro.url.pathname}
>
  <CustomPageBlocks blocks={page.blocks} />
</BaseLayout>
