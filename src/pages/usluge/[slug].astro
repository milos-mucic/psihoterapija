---
export const prerender = false;

import BaseLayout from "@/components/components/BaseLayout.astro";
import ServiceDetailPage from "@/components/pages/ServiceDetailPage.astro";
import { pageContentService } from "@/features/page-content/services/page-content.service";

const slug = Astro.params.slug as string;
const content = await pageContentService.getServiceDetailPageData(slug);

if (!content) {
  return new Response("Not found", { status: 404 });
}
---

<BaseLayout
  title={content.seo.title}
  description={content.seo.description}
  canonicalPath={`/usluge/${content.slug}/`}
  appBarTone="dark"
  appBarOverlay={true}
>
  <ServiceDetailPage data={content} />
</BaseLayout>
