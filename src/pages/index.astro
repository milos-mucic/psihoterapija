---
export const prerender = false;

import HomeHeroSection from "@/components/sections/HomeHeroSection.astro";
import HomePageContent from "@/components/sections/HomePageContent.astro";
import { blogService } from "@/features/blog/services/blog.service";
import { pageContentService } from "@/features/page-content/services/page-content.service";
import { getBlockBackgroundStyle } from "@/features/page-content/admin/block-backgrounds";
import BaseLayout from "@/components/components/BaseLayout.astro";

const locale = "sr-latn";
const content = await pageContentService.getHomePageData(locale);
const posts = (await blogService.listPublishedPosts(locale)).slice(0, 3);
---

<BaseLayout
  title={content.seo.title}
  description={content.seo.description}
  locale={locale}
  canonicalPath="/"
>
  {!content.hiddenBlocks?.includes("home-hero") && (
    <HomeHeroSection
      titleHtml={content.hero.titleHtml}
      description={content.hero.description}
      primaryAction={content.hero.primaryAction}
      secondaryAction={content.hero.secondaryAction}
      blockStyle={getBlockBackgroundStyle(content.blockBackgrounds, "home-hero")}
    />
  )}

  <HomePageContent locale={locale} content={content} posts={posts} />
</BaseLayout>
