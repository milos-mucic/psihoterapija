---
export const prerender = false;

import AppointmentPage from "@/components/pages/AppointmentPage.astro";
import { pageContentService } from "@/features/page-content/services/page-content.service";
import BaseLayout from "@/components/components/BaseLayout.astro";

const content = await pageContentService.getAppointmentPageData();
---

<BaseLayout
  title={content.seo.title}
  description={content.seo.description}
  canonicalPath="/zakazivanje/"
  appBarTone="light"
>
  <AppointmentPage />
</BaseLayout>
