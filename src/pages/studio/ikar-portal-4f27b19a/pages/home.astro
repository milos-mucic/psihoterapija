---
export const prerender = false;

import AdminHomePageForm from "@/components/components/AdminHomePageForm.astro";
import { getDictionary } from "@/features/i18n/translate";
import { getAdminPreviewHref } from "@/features/page-content/admin/page-route-map";
import { pageContentService } from "@/features/page-content/services/page-content.service";
import { adminConfig } from "@/lib/config/admin";
import AdminLayout from "@/components/components/AdminLayout.astro";
import { adminGuard } from "@/features/admin/auth/admin-guard";

const guard = adminGuard(Astro);
if (guard) return guard;

const dictionary = getDictionary();
const content = await pageContentService.getManagedHomeContent();
const saved = Astro.url.searchParams.get("saved") === "1";
const error = Astro.url.searchParams.get("error");
const previewHref = getAdminPreviewHref("home");
---

<AdminLayout
  title={dictionary.admin.pages.homeTitle}
  active="pages"
  breadcrumb={[
    { label: "Stranice", href: `${adminConfig.basePath}/pages/` },
    { label: dictionary.admin.pages.homeTitle },
  ]}
>
  <div class="admin-grid">
    {saved ? (
      <p class="admin-status" data-tone="success">
        {dictionary.admin.pages.messages.saved}
      </p>
    ) : error === "validation" ? (
      <p class="admin-status" data-tone="error">
        {dictionary.admin.pages.messages.validationError}
      </p>
    ) : null}

    <div class="card admin-page-header">
      <div class="admin-page-header__content">
        <div>
          <p class="admin-kicker">Homepage Editing</p>
          <h2>{dictionary.admin.pages.homeTitle}</h2>
          <p class="admin-page-header__copy">{dictionary.admin.pages.homeCopy}</p>
        </div>
      </div>
    </div>

    <div class="admin-editor-layout" data-admin-page-editor>
      <div class="admin-editor-layout__form">
        <AdminHomePageForm
          action="/api/admin/pages/home"
          content={content}
          previewBaseHref={previewHref}
        />
      </div>
    </div>
  </div>
</AdminLayout>
