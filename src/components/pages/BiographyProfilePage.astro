---
import { stripHtmlTags } from "@/features/page-content/admin/technical-fields";
import AppointmentForm from "@/components/components/AppointmentForm.astro";
import PageBanner from "@/components/sections/PageBanner.astro";
import { getDictionary } from "@/features/i18n/translate";
import { pageContentService } from "@/features/page-content/services/page-content.service";
import type { SiteLocale } from "@/lib/config/site";

type Props = {
  locale: SiteLocale;
  slug: string;
};

const { locale, slug } = Astro.props;
const content = await pageContentService.getBiographyProfilePageData(locale, slug);
const appointmentContent = await pageContentService.getAppointmentPageData(locale);
const dictionary = getDictionary(locale);

if (!content) {
  throw new Error(`Missing biography profile data for slug: ${slug}`);
}
---

<div class="biography-profile-page__banner">
  <PageBanner {...content.banner} />
</div>

<section class="page-section biography-profile-page__intro">
  <div class="container">
    <div class="biography-profile-page__grid">
      <div class="biography-profile-page__media" data-reveal="left">
        <img
          src={content.profile.image}
          alt={stripHtmlTags(content.profile.title)}
          loading="eager"
          data-image-component
        />
      </div>

      <div class="biography-profile-page__copy" data-reveal="right" style="--reveal-delay: 90ms;">
        <p class="biography-profile-page__role" set:html={content.profile.role} />
        <h1 set:html={content.profile.title} />
        <div
          class="biography-profile-page__summary richtext-shell"
          set:html={content.profile.summary}
        />

        <ul class="biography-profile-page__tags">
          {content.profile.highlights.map((tag) => <li>{tag}</li>)}
        </ul>

        <div class="biography-profile-page__actions">
          <a class="home-button" href={content.backHref}>{content.backLabel}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="page-section page-section--soft biography-profile-page__body">
  <div class="container container--narrow">
    <div class="biography-profile-page__body-card" data-reveal="up">
      <div class="richtext-shell" set:html={content.profile.body} />
    </div>
  </div>
</section>

<section class="home-section home-section--tight biography-profile-page__booking">
  <div class="container">
    <div class="home-booking biography-profile-page__booking-grid">
      <div class="home-booking__intro" data-reveal="up">
        <h2 set:html={dictionary.common.biographyBookingTitle} />
        <div class="richtext-shell" set:html={appointmentContent.introCopy} />
      </div>

      <div data-reveal="up" style="--reveal-delay: 90ms;">
        <AppointmentForm
          locale={locale}
          labels={dictionary.forms}
          formatLabel={appointmentContent.formatLabel}
          formats={appointmentContent.formats}
        />
      </div>
    </div>
  </div>
</section>

{
  content.relatedProfiles.length > 0 ? (
    <section class="home-section home-section--tight">
      <div class="container">
        <div class="home-heading-row" data-reveal="up">
          <div class="home-heading-copy">
            <h2 set:html={content.relatedTitle} />
          </div>
          <a class="home-button" href={content.backHref}>
            {content.backLabel}
          </a>
        </div>

        <div class="biography-profile-page__related-grid">
          {content.relatedProfiles.map((profile, index) => (
            <a
              class="biography-profile-page__related-card"
              href={profile.href}
              data-reveal="up"
              style={`--reveal-delay: ${index * 70}ms;`}
            >
              <span class="biography-profile-page__related-media">
                <img src={profile.image} alt={stripHtmlTags(profile.title)} loading="lazy" data-image-component />
              </span>
              <p class="biography-profile-page__related-role" set:html={profile.role} />
              <h3 set:html={profile.title} />
              <div class="richtext-shell" set:html={profile.summary} />
            </a>
          ))}
        </div>
      </div>
    </section>
  ) : null
}

<style>
  .biography-profile-page__intro {
    padding-top: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .biography-profile-page__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: stretch;
  }

  .biography-profile-page__media {
    position: relative;
    overflow: hidden;
    border-radius: 1.5rem;
    background: rgba(22, 60, 61, 0.04);
    min-height: 22rem;
  }

  .biography-profile-page__media::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 1.5rem;
    box-shadow: inset 0 0 0 1px rgba(22, 60, 61, 0.06);
    pointer-events: none;
  }

  .biography-profile-page__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .biography-profile-page__copy {
    display: grid;
    gap: 1.15rem;
    align-content: start;
  }

  .biography-profile-page__role,
  .biography-profile-page__related-role {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0;
    color: var(--primary);
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .biography-profile-page__role::before,
  .biography-profile-page__related-role::before {
    content: "";
    width: 1.8rem;
    height: 1px;
    background: currentColor;
    opacity: 0.5;
  }

  .biography-profile-page__copy h1 {
    font-size: clamp(2.4rem, 5.2vw, 4.25rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .biography-profile-page__summary {
    margin-top: 1rem;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.75;
    max-width: 36rem;
  }

  .biography-profile-page__summary :global(p),
  .biography-profile-page__summary :global(ul),
  .biography-profile-page__summary :global(ol) {
    margin: 0;
    line-height: 1.75;
  }

  .biography-profile-page__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.8rem;
    margin: 0.2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .biography-profile-page__tags li {
    color: var(--muted);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
  }

  .biography-profile-page__tags li:not(:last-child)::after {
    content: "·";
    margin-left: 0.8rem;
    opacity: 0.5;
  }

  .biography-profile-page__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .biography-profile-page__actions .home-button {
    align-self: flex-start;
    padding: 0.6rem 1.15rem;
    font-size: 0.92rem;
    line-height: 1.2;
    height: auto;
  }

  .biography-profile-page__body {
    padding-top: clamp(1.5rem, 3.5vw, 2.5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    background: transparent;
  }

  .biography-profile-page__body .container--narrow {
    max-width: 46rem;
  }

  .biography-profile-page__body-card {
    position: relative;
    display: grid;
    gap: 1.2rem;
    padding: clamp(2.5rem, 5vw, 4rem) clamp(2rem, 4.5vw, 3.5rem);
    border: none;
    border-radius: 1.5rem;
    background: #ffffff;
    box-shadow: 0 30px 80px -24px rgba(16, 47, 48, 0.18);
    font-size: 1.05rem;
    color: var(--foreground);
  }

  .biography-profile-page__body-card::before {
    content: "";
    position: absolute;
    top: 2.25rem;
    left: clamp(2rem, 4.5vw, 3.5rem);
    width: 2.25rem;
    height: 2px;
    background: var(--primary);
    border-radius: 999px;
  }

  .biography-profile-page__body-card > :global(*:first-child) {
    padding-top: 0.6rem;
  }

  .biography-profile-page__body-card :global(p:first-of-type) {
    font-size: 1.18rem;
    line-height: 1.7;
    color: var(--foreground);
  }

  .biography-profile-page__body-card :global(p),
  .biography-profile-page__body-card :global(ul),
  .biography-profile-page__body-card :global(ol) {
    margin: 0;
    line-height: 1.85;
  }

  .biography-profile-page__body-card :global(h2) {
    margin-top: 1.5rem;
    font-size: clamp(1.5rem, 2.6vw, 1.9rem);
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .biography-profile-page__body-card :global(h3) {
    margin-top: 1.25rem;
    font-size: 1.25rem;
    line-height: 1.25;
  }

  .biography-profile-page__body-card :global(blockquote) {
    margin: 1.5rem 0;
    padding: 0.25rem 0 0.25rem 1.5rem;
    border-left: 2px solid var(--primary);
    color: var(--muted);
    font-style: italic;
    line-height: 1.7;
  }

  .biography-profile-page__booking {
    padding-top: 0.5rem;
  }

  .biography-profile-page__booking-grid {
    gap: clamp(1.4rem, 4vw, 2.1rem);
  }

  .biography-profile-page__related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 2rem 1.75rem;
    margin-top: 3rem;
  }

  .biography-profile-page__related-card {
    display: flex;
    flex-direction: column;
    background: transparent;
    transition: transform 280ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .biography-profile-page__related-card:hover {
    color: inherit;
    transform: translateY(-4px);
  }

  .biography-profile-page__related-media {
    display: block;
    overflow: hidden;
    border-radius: 1rem;
    background: rgba(22, 60, 61, 0.04);
    aspect-ratio: 1 / 1;
  }

  .biography-profile-page__related-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .biography-profile-page__related-card:hover img {
    transform: scale(1.04);
  }

  .biography-profile-page__related-card > :global(.biography-profile-page__related-role) {
    margin-top: 1.35rem;
  }

  .biography-profile-page__related-card h3 {
    margin-top: 0.5rem;
    font-size: 1.35rem;
    line-height: 1.18;
    letter-spacing: -0.01em;
  }

  .biography-profile-page__related-card .richtext-shell {
    margin-top: 1rem;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .biography-profile-page__related-card .richtext-shell :global(p) {
    margin: 0;
  }

  @media (max-width: 960px) {
    .biography-profile-page__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .biography-profile-page__media img {
      aspect-ratio: 4 / 5;
    }
  }
</style>
