---
import PageBanner from "@/components/sections/PageBanner.astro";
import { pageContentService } from "@/features/page-content/services/page-content.service";
import { getBlockBackgroundStyle } from "@/features/page-content/admin/block-backgrounds";

type Props = {
  content?: Awaited<ReturnType<typeof pageContentService.getPricingPageData>>;
};

const { content: previewContent } = Astro.props;
const content = previewContent ?? (await pageContentService.getPricingPageData());
const blockBg = (fragment: string) => getBlockBackgroundStyle(content.blockBackgrounds, fragment);
---

{!content.hiddenBlocks?.includes("pricing-banner") && (
  <PageBanner {...content.banner} sectionId="pricing-banner" blockStyle={blockBg("pricing-banner")} />
)}

{!content.hiddenBlocks?.includes("pricing-plans") && (
<section id="pricing-plans" class="page-section pricing-page__plans-section" style={blockBg("pricing-plans")}>
  <div class="container">
    <div class="pricing-page__grid">
      {
        content.plans.map((plan, index) => (
          <a
            class="pricing-page__card"
            href={plan.ctaHref}
            data-reveal="up"
            style={`--reveal-delay: ${index * 90}ms;`}
          >
            <h3 set:html={plan.title} />
            <p class="pricing-page__price" set:html={plan.price} />
            <span class="pricing-page__cta">
              <span class="pricing-page__cta-label" set:html={plan.ctaLabel} />
              <span class="pricing-page__cta-arrow" aria-hidden="true">→</span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
)}

{!content.hiddenBlocks?.includes("pricing-info") && (
<section id="pricing-info" class="page-section pricing-page__info-section" style={blockBg("pricing-info")}>
  <div class="container">
    <div class="pricing-page__info-grid">
      {
        content.infoCards.map((card, index) => (
          <article
            class="pricing-page__info-card"
            data-reveal="up"
            style={`--reveal-delay: ${index * 85}ms;`}
          >
            <h4 set:html={card.title} />
            <div class="richtext-shell" set:html={card.copy} />
          </article>
        ))
      }
    </div>
  </div>
</section>
)}

<style>
  .pricing-page__plans-section {
    /* Top is normalized to 2.5rem by the global `.page-banner + *` rule; match the bottom
       so the cards sit equally far from the banner above and the footer below. */
    padding-top: 2.5rem;
    padding-bottom: 2.5rem;
  }

  .pricing-page__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .pricing-page__card {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 0.95rem;
    padding: 1.55rem 1.4rem;
    border-radius: 12px;
    border: 1px solid rgba(15, 60, 61, 0.12);
    background: #f9f8f5;
    box-shadow: 0 14px 34px rgba(16, 47, 48, 0.08);
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    transition:
      transform 300ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 300ms ease,
      border-color 300ms ease,
      background 300ms ease;
  }

  .pricing-page__card:hover,
  .pricing-page__card:focus-visible {
    transform: translateY(-8px);
    border-color: var(--accent-strong);
    background: #fff;
    box-shadow: 0 24px 48px rgba(16, 47, 48, 0.16);
    outline: none;
  }

  .pricing-page__card:focus-visible {
    outline: 2px solid var(--accent-strong);
    outline-offset: 3px;
  }

  .pricing-page__card:active {
    transform: translateY(-4px);
  }

  .pricing-page__card h3 {
    font-size: clamp(1.4rem, 2.8vw, 1.9rem);
    line-height: 1.15;
    color: var(--primary);
  }

  .pricing-page__price {
    color: var(--primary);
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    font-family: var(--font-display);
    line-height: 1;
    margin-top: 0.25rem;
  }

  .pricing-page__outside {
    color: var(--foreground);
    line-height: 1.6;
  }

  .pricing-page__outside :global(p) {
    text-align: center;
  }

  .pricing-page__outside :global(p),
  .pricing-page__outside :global(ul),
  .pricing-page__outside :global(ol),
  .pricing-page__info-card :global(p),
  .pricing-page__info-card :global(ul),
  .pricing-page__info-card :global(ol) {
    margin: 0;
    line-height: 1.62;
  }

  .pricing-page__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.15rem;
    font-weight: 600;
    color: var(--primary);
    position: relative;
    transition: color 220ms ease, transform 220ms ease;
  }

  .pricing-page__cta-label {
    position: relative;
  }

  .pricing-page__cta-label::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 280ms ease;
  }

  .pricing-page__cta-arrow {
    display: inline-block;
    transition: transform 260ms ease;
  }

  .pricing-page__card:hover .pricing-page__cta,
  .pricing-page__card:focus-visible .pricing-page__cta {
    color: var(--accent-strong);
  }

  .pricing-page__card:hover .pricing-page__cta-label::after,
  .pricing-page__card:focus-visible .pricing-page__cta-label::after {
    transform: scaleX(1);
    transform-origin: left center;
  }

  .pricing-page__card:hover .pricing-page__cta-arrow,
  .pricing-page__card:focus-visible .pricing-page__cta-arrow {
    transform: translateX(5px);
  }

  @media (prefers-reduced-motion: reduce) {
    .pricing-page__card,
    .pricing-page__cta,
    .pricing-page__cta-label::after,
    .pricing-page__cta-arrow {
      transition: none;
    }

    .pricing-page__card:hover,
    .pricing-page__card:focus-visible {
      transform: none;
    }
  }

  .pricing-page__info-section {
    padding-top: 0.2rem;
  }

  .pricing-page__info-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .pricing-page__info-card {
    border-radius: 12px;
    border: 1px solid var(--line);
    background: #fff;
    box-shadow: 0 12px 30px rgba(16, 47, 48, 0.07);
    padding: 1.2rem 1.2rem;
    text-align: center;
  }

  .pricing-page__info-card :global(.richtext-shell),
  .pricing-page__info-card :global(p),
  .pricing-page__info-card :global(ul),
  .pricing-page__info-card :global(ol),
  .pricing-page__info-card :global(li) {
    text-align: center;
    list-style-position: inside;
  }

  .pricing-page__info-card h4 {
    color: var(--primary);
    font-size: clamp(1.2rem, 2.2vw, 1.65rem);
    line-height: 1.2;
    margin-bottom: 0.55rem;
  }

  .pricing-page__info-card p {
    color: var(--foreground);
    line-height: 1.62;
  }

  @media (max-width: 1100px) {
    .pricing-page__grid,
    .pricing-page__info-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 760px) {
    .pricing-page__plans-section {
      padding-top: 2rem;
      padding-bottom: 2rem;
    }

    .pricing-page__grid,
    .pricing-page__info-grid {
      grid-template-columns: 1fr;
    }

    .pricing-page__card,
    .pricing-page__info-card {
      padding: 1rem;
    }
  }

  @media (max-width: 960px) {
    .pricing-page__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
