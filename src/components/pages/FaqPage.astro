---
import PageBanner from "@/components/sections/PageBanner.astro";
import FaqAccordionSection from "@/components/sections/FaqAccordionSection.astro";
import { pageContentService } from "@/features/page-content/services/page-content.service";
import { getBlockBackgroundStyle } from "@/features/page-content/admin/block-backgrounds";
import type { SiteLocale } from "@/lib/config/site";

type Props = {
  locale: SiteLocale;
  content?: Awaited<ReturnType<typeof pageContentService.getFaqPageData>>;
};

const { locale, content: previewContent } = Astro.props;
const content = previewContent ?? (await pageContentService.getFaqPageData(locale));
const blockBg = (fragment: string) => getBlockBackgroundStyle(content.blockBackgrounds, fragment);
---

{!content.hiddenBlocks?.includes("faq-banner") && (
  <PageBanner {...content.banner} sectionId="faq-banner" blockStyle={blockBg("faq-banner")} />
)}

{!content.hiddenBlocks?.includes("faq-items") && (
  <FaqAccordionSection
    items={content.items}
    image={content.faqImage}
    imageLoading="eager"
    sectionClass="page-section--soft faq-page__accordion-section"
    sectionId="faq-items"
    blockStyle={blockBg("faq-items")}
  />
)}

<style>
  :global(#faq-items) {
    padding-top: clamp(3.4rem, 7vw, 4.8rem);
  }

  .faq-page__accordion-section :global(.faq-accordion__media) {
    min-height: clamp(15rem, 28vw, 20rem);
  }
</style>
