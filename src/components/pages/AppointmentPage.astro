---
import PageBanner from "@/components/sections/PageBanner.astro";
import FaqAccordionSection from "@/components/sections/FaqAccordionSection.astro";
import AppointmentForm from "@/components/components/AppointmentForm.astro";
import { getDictionary } from "@/features/i18n/translate";
import { pageContentService } from "@/features/page-content/services/page-content.service";
import { getBlockBackgroundStyle } from "@/features/page-content/admin/block-backgrounds";

type Props = {
  content?: Awaited<ReturnType<typeof pageContentService.getAppointmentPageData>>;
};

const { content: previewContent } = Astro.props;
const content = previewContent ?? (await pageContentService.getAppointmentPageData());
const dictionary = getDictionary();
const blockBg = (fragment: string) => getBlockBackgroundStyle(content.blockBackgrounds, fragment);
---

{!content.hiddenBlocks?.includes("appointment-banner") && (
  <PageBanner
    {...content.banner}
    sectionId="appointment-banner"
    blockStyle={blockBg("appointment-banner")}
  />
)}

{!content.hiddenBlocks?.includes("appointment-booking") && (
<section
  id="appointment-booking"
  class="home-section home-section--tight appointment-page__booking"
  style={blockBg("appointment-booking")}
>
  <div class="container">
    <div class="home-booking appointment-page__booking-grid">
      <div class="home-booking__intro" data-reveal="up">
        <h2 set:html={content.formTitle} />
        <div class="appointment-page__intro-copy richtext-shell" set:html={content.introCopy} />
      </div>

      <div data-reveal="up" style="--reveal-delay: 90ms;">
        <AppointmentForm
          labels={dictionary.forms}
          formatLabel={content.formatLabel}
          formats={content.formats}
        />
      </div>
    </div>
  </div>
</section>
)}

{!content.hiddenBlocks?.includes("appointment-faq") && (
<FaqAccordionSection
  items={content.faqs}
  image={content.faqImage}
  imageLoading="eager"
  sectionClass="page-section--soft appointment-page__accordion-section"
  sectionId="appointment-faq"
  blockStyle={blockBg("appointment-faq")}
/>
)}

<style>
  .appointment-page__booking {
    padding-top: 0.5rem;
  }

  .appointment-page__booking-grid {
    gap: clamp(1.4rem, 4vw, 2.1rem);
  }

  .appointment-page__intro-copy :global(p),
  .appointment-page__intro-copy :global(ul),
  .appointment-page__intro-copy :global(ol) {
    margin: 0;
    line-height: 1.7;
  }

  .appointment-page__booking :global(.stack-form) {
    padding: 1.9rem;
    border-radius: 1rem;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 18px 44px rgba(16, 47, 48, 0.08);
  }

  :global(.appointment-page__accordion-section) {
    padding-top: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  :global(.appointment-page__accordion-section .faq-accordion) {
    align-items: center;
    padding-top: 30px;
    padding-bottom: 30px;
  }

  :global(.appointment-page__accordion-section .faq-accordion__media) {
    min-height: clamp(15rem, 28vw, 20rem);
  }

  @media (max-width: 720px) {
    .appointment-page__booking :global(.stack-form) {
      padding: 1.2rem;
    }

    :global(.appointment-page__accordion-section) {
      padding-top: 2rem;
      padding-bottom: 2rem;
    }

    :global(.appointment-page__accordion-section .faq-accordion) {
      padding-top: 20px;
      padding-bottom: 20px;
    }
  }
</style>
