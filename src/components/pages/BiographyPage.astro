---
import { stripHtmlTags } from "@/features/page-content/admin/technical-fields";
import BaseLayout from "@/components/components/BaseLayout.astro";
import PageBanner from "@/components/sections/PageBanner.astro";
import { getDictionary } from "@/features/i18n/translate";
import { pageContentService } from "@/features/page-content/services/page-content.service";
import { getBlockBackgroundStyle } from "@/features/page-content/admin/block-backgrounds";

type Props = {
  content?: Awaited<ReturnType<typeof pageContentService.getBiographyPageData>>;
};

const { content: previewContent } = Astro.props;
const dictionary = getDictionary();
const canonicalPath = "/biografija/";
const content = previewContent ?? (await pageContentService.getBiographyPageData());
const blockBg = (fragment: string) => getBlockBackgroundStyle(content.blockBackgrounds, fragment);
---

<BaseLayout
  title={stripHtmlTags(content.seo.title)}
  description={content.seo.description}
  canonicalPath={canonicalPath}
  appBarTone="dark"
  appBarOverlay={true}
>
  {!content.hiddenBlocks?.includes("biography-banner") && (
    <PageBanner {...content.banner} sectionId="biography-banner" blockStyle={blockBg("biography-banner")} />
  )}

  {!content.hiddenBlocks?.includes("biography-cards") && (
  <section id="biography-cards" class="page-section" style={blockBg("biography-cards")}>
    <div class="container">
      <header class="page-section__header biography-page__header" data-reveal="up">
        <h2 set:html={content.cardsTitle} />
        <div class="biography-page__richtext richtext-shell" set:html={content.cardsCopy} />
      </header>

      <div class="biography-page__cards">
        {
          content.cards.map((card, index) => (
            <a
              class="biography-page__card"
              href={card.href}
              data-reveal="up"
              style={`--reveal-delay: ${index * 90}ms;`}
            >
              <div class="biography-page__card-media">
                <img src={card.image} alt={stripHtmlTags(card.title)} loading="lazy" data-image-component />
              </div>
              <div class="biography-page__card-body">
                <p class="biography-page__role" set:html={card.role} />
                <h3 set:html={card.title} />
                <div class="biography-page__richtext richtext-shell" set:html={card.summary} />
                <ul class="biography-page__tags">
                  {card.highlights.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
  )}

  {!content.hiddenBlocks?.includes("biography-approach") && (
  <section id="biography-approach" class="page-section page-section--soft" style={blockBg("biography-approach")}>
    <div class="container">
      <div class="biography-page__approach">
        <img
          class="biography-page__approach-image"
          src={content.approachImage}
          alt={stripHtmlTags(content.approachTitle)}
          loading="lazy"
          data-image-component
          data-reveal="left"
        />
        <div
          class="biography-page__approach-copy"
          data-reveal="right"
          style="--reveal-delay: 90ms;"
        >
          <h2 set:html={content.approachTitle} />
          <div class="biography-page__richtext richtext-shell" set:html={content.approachCopy} />
          <ul class="home-list biography-page__list">
            {content.approachPoints.map((point) => <li set:html={point} />)}
          </ul>
          <a class="home-button" href={content.ctaHref} set:html={content.ctaLabel} />
        </div>
      </div>
    </div>
  </section>
  )}

  <style>
    #biography-cards.page-section {
      position: relative;
    }

    #biography-cards.page-section::before {
      content: "";
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: min(calc(100% - 1.875rem), var(--container));
      height: 1px;
      background: var(--line);
    }

    .biography-page__header {
      max-width: 46rem;
      margin-bottom: 4rem;
    }

    .biography-page__header h2 {
      font-size: clamp(2rem, 3.4vw, 2.65rem);
      line-height: 1.1;
      letter-spacing: -0.02em;
    }

    .biography-page__richtext {
      display: grid;
      gap: 0.75rem;
      color: var(--muted);
    }

    .biography-page__richtext :global(p),
    .biography-page__richtext :global(ul),
    .biography-page__richtext :global(ol) {
      margin: 0;
      line-height: 1.75;
    }

    .biography-page__cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
      gap: 2rem 1.75rem;
    }

    .biography-page__card {
      display: grid;
      grid-template-rows: auto 1fr;
      border-radius: 1.25rem;
      background: transparent;
      overflow: hidden;
      transition:
        transform 280ms cubic-bezier(0.2, 0.7, 0.2, 1),
        box-shadow 280ms ease;
    }

    .biography-page__card:hover {
      color: inherit;
      transform: translateY(-4px);
    }

    .biography-page__card-media {
      aspect-ratio: 1 / 1;
      overflow: hidden;
      border-radius: 1rem;
      background: rgba(22, 60, 61, 0.04);
      position: relative;
    }

    .biography-page__card-media::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: 1rem;
      box-shadow: inset 0 0 0 1px rgba(22, 60, 61, 0.06);
      pointer-events: none;
      transition: box-shadow 280ms ease;
    }

    .biography-page__card:hover .biography-page__card-media::after {
      box-shadow: inset 0 0 0 1px rgba(22, 60, 61, 0.16);
    }

    .biography-page__card-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
    }

    .biography-page__card:hover .biography-page__card-media img {
      transform: scale(1.05);
    }

    .biography-page__card-body {
      display: grid;
      gap: 0.5rem;
      padding: 1.35rem 0.15rem 0;
    }

    .biography-page__card-body > .biography-page__richtext {
      margin-top: 1rem;
    }

    .biography-page__role {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      margin: 0;
      color: var(--primary);
      font-size: 0.74rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      font-weight: 500;
    }

    .biography-page__role::before {
      content: "";
      width: 1.6rem;
      height: 1px;
      background: currentColor;
      opacity: 0.5;
    }

    .biography-page__card h3 {
      font-size: 1.4rem;
      line-height: 1.18;
      letter-spacing: -0.01em;
    }

    .biography-page__card .biography-page__richtext {
      color: var(--muted);
      font-size: 0.95rem;
    }

    .biography-page__tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin: 0.35rem 0 0;
      padding: 0;
      list-style: none;
    }

    .biography-page__tags li {
      padding: 0.25rem 0;
      color: var(--muted);
      font-size: 0.78rem;
      letter-spacing: 0.02em;
    }

    .biography-page__tags li:not(:last-child)::after {
      content: "·";
      margin-left: 0.4rem;
      opacity: 0.5;
    }

    .biography-page__approach {
      display: grid;
      grid-template-columns: minmax(18rem, 34rem) minmax(0, 1fr);
      gap: clamp(2rem, 5vw, 3.5rem);
      align-items: center;
    }

    .biography-page__approach-image {
      width: 100%;
      border-radius: 1.25rem;
      object-fit: cover;
      box-shadow: 0 30px 64px rgba(16, 47, 48, 0.14);
    }

    .biography-page__approach-copy {
      display: grid;
      gap: 1.1rem;
      max-width: 38rem;
    }

    .biography-page__approach-copy h2 {
      font-size: clamp(2rem, 4vw, 3rem);
      line-height: 1.08;
      letter-spacing: -0.02em;
    }

    .biography-page__list {
      display: grid;
      gap: 0.65rem;
      margin: 0.4rem 0 0.6rem;
      padding: 0;
      list-style: none;
    }

    .biography-page__list :global(li) {
      position: relative;
      padding-left: 1.5rem;
      line-height: 1.7;
      color: var(--foreground);
    }

    .biography-page__list :global(li)::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0.6rem;
      width: 0.55rem;
      height: 0.55rem;
      border-radius: 999px;
      background: var(--primary);
      opacity: 0.85;
    }

    .biography-page__approach-copy .home-button {
      width: fit-content;
      margin-top: 0.5rem;
    }

    @media (max-width: 960px) {
      .biography-page__cards {
        grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
        gap: 1.75rem 1.25rem;
      }

      .biography-page__approach {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
