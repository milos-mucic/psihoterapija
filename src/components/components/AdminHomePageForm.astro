---
import AdminBlockBackgroundPicker from "@/components/components/AdminBlockBackgroundPicker.astro";
import AdminBlockVisibilityToggle from "@/components/components/AdminBlockVisibilityToggle.astro";
import { AdminMediaField } from "@/components/components/AdminMediaField";
import { AdminRichTextField } from "@/components/components/AdminRichTextField";
import { getDictionary } from "@/features/i18n/translate";
import { stripHtmlTags } from "@/features/page-content/admin/technical-fields";
import type { HomePageManagedContent } from "@/features/page-content/types/page-content.types";

type Props = {
  action: string;
  content: HomePageManagedContent;
  previewBaseHref: string;
  themeTabPool: Array<{ label: string; summaryTitle: string }>;
};

const { action, content, previewBaseHref, themeTabPool } = Astro.props;
const themeTabOptions = themeTabPool.map((tab, index) => ({
  index,
  label: stripHtmlTags(tab.summaryTitle) || stripHtmlTags(tab.label) || `Tema ${index + 1}`,
}));
const hiddenBlocksList = content.hiddenBlocks ?? [];
const blockBackgrounds = content.blockBackgrounds ?? {};
const isBlockHidden = (fragment: string) => hiddenBlocksList.includes(fragment);
const getBlockBackgroundKey = (fragment: string) => blockBackgrounds[fragment] ?? "default";
const videoAccept = "video/*,.mp4,.webm,.mov,.ogg,.ogv";
const richTextLabels = {
  bold: "Bold",
  italic: "Italic",
  underline: "Underline",
  heading2: "Heading 2",
  heading3: "Heading 3",
  bulletList: "Lista",
  orderedList: "Numerisana lista",
  quote: "Citat",
  link: "Link",
  image: "Slika",
  clear: "Ukloni format",
  uploadFailed: "Upload slike nije uspeo.",
  fontSize: "Veličina fonta",
  fontFamily: "Font",
  textColor: "Boja teksta",
  highlightColor: "Marker (pozadina)",
  alignLeft: "Poravnaj levo",
  alignCenter: "Centriraj",
  alignRight: "Poravnaj desno",
  alignJustify: "Obostrano poravnanje",
};

const heroTitleRichTextLabels = {
  ...richTextLabels,
  placeholder: "Naslov hero sekcije",
};
const defaultServiceItems = [
  {
    title: getDictionary().homePage.services.items[0].title,
    copy: `<p>${getDictionary().homePage.services.items[0].copy}</p>`,
    image: "/legacy/images/White-Icon-2.png",
  },
  {
    title: getDictionary().homePage.services.items[1].title,
    copy: `<p>${getDictionary().homePage.services.items[1].copy}</p>`,
    image: "/legacy/images/mirrored/logo-service-3.png",
  },
  {
    title: getDictionary().homePage.services.items[2].title,
    copy: `<p>${getDictionary().homePage.services.items[2].copy}</p>`,
    image: "/legacy/images/White-Icon-1.png",
  },
];
const normalizedServiceItems = Array.from({ length: 3 }, (_, index) => ({
  title: content.services.items[index]?.title ?? defaultServiceItems[index].title,
  copy: content.services.items[index]?.copy ?? defaultServiceItems[index].copy,
  image: content.services.items[index]?.image ?? defaultServiceItems[index].image,
}));
---

<form
  class="admin-form"
  method="post"
  action={action}
  data-admin-section-preview-root
  data-admin-preview-endpoint="/api/admin/pages/preview"
  data-preview-base-href={previewBaseHref}
>
  <input type="hidden" name="pageKey" value="home" />
  <input type="hidden" name="previewToken" value="" data-admin-preview-token />

  <div
    class="card"
    style="padding: 1.5rem;"
    data-section-preview
    data-section-preview-fragment="home-hero"
  >
    <div class="page-grid">
      <div>
        <h2 style="margin: 0;">SEO</h2>
        <p class="section-copy">Astro i dalje renderuje meta tagove, ali tekst sada dolazi iz CMS-a.</p>
      </div>

      <div class="admin-form__grid">
        <label class="admin-form__field admin-form__field--full">
          <span>SEO naslov</span>
          <input class="input-control" name="seoTitle" value={content.seo.title} />
        </label>

        <label class="admin-form__field admin-form__field--full">
          <span>Meta opis</span>
          <textarea class="input-control input-control--textarea" name="seoDescription" rows={3}
            >{content.seo.description}</textarea
          >
        </label>
      </div>
    </div>
  </div>

  <div
    class="card"
    style="padding: 1.5rem;"
    data-section-preview
    data-section-preview-fragment="home-hero"
  >
    <AdminBlockVisibilityToggle fragment="home-hero" hidden={isBlockHidden("home-hero")} />
    <AdminBlockBackgroundPicker fragment="home-hero" value={getBlockBackgroundKey("home-hero")} />
    <div class="page-grid">
      <div>
        <h2 style="margin: 0;">Hero sekcija</h2>
        <p class="section-copy">Naslov i opis sada koriste isti Lexical rich text editor.</p>
      </div>

      <div class="admin-form__grid">
        <div class="admin-form__field admin-form__field--full">
          <span>Naslov hero sekcije</span>
          <AdminRichTextField
            client:load
            name="heroTitleHtml"
            initialValue={content.hero.titleHtml}
            mode="inline"
            uploadUrl="/api/admin/media/upload"
            uploadFolder="pages/home"
            labels={heroTitleRichTextLabels}
          />
        </div>

        <div class="admin-form__field admin-form__field--full">
          <span>Opis hero sekcije</span>
          <AdminRichTextField
            client:load
            name="heroDescription"
            initialValue={content.hero.description}
            uploadUrl="/api/admin/media/upload"
            uploadFolder="pages/home"
            labels={richTextLabels}
          />
        </div>

        <div class="admin-form__field">
          <span>Labela primarnog dugmeta</span>
          <AdminRichTextField
            client:load
            name="heroPrimaryActionLabel"
            initialValue={content.hero.primaryActionLabel}
            mode="inline"
            uploadUrl="/api/admin/media/upload"
            uploadFolder="pages/home"
            labels={richTextLabels}
          />
        </div>

        <div class="admin-form__field">
          <span>Labela sekundarnog linka</span>
          <AdminRichTextField
            client:load
            name="heroSecondaryActionLabel"
            initialValue={content.hero.secondaryActionLabel}
            mode="inline"
            uploadUrl="/api/admin/media/upload"
            uploadFolder="pages/home"
            labels={richTextLabels}
          />
        </div>
      </div>
    </div>
  </div>

  <div
    class="card"
    style="padding: 1.5rem;"
    data-section-preview
    data-section-preview-fragment="home-prompt"
  >
    <AdminBlockVisibilityToggle fragment="home-prompt" hidden={isBlockHidden("home-prompt")} />
    <AdminBlockBackgroundPicker fragment="home-prompt" value={getBlockBackgroundKey("home-prompt")} />
    <div class="page-grid">
      <div>
        <h2 style="margin: 0;">Kontakt prompt</h2>
        <p class="section-copy">Sekcija odmah ispod hero dela.</p>
      </div>

      <div class="admin-form__grid">
        <div class="admin-form__field">
          <span>Naslov</span>
          <AdminRichTextField
            client:load
            name="promptTitle"
            initialValue={content.prompt.title}
            mode="inline"
            uploadUrl="/api/admin/media/upload"
            uploadFolder="pages/home"
            labels={richTextLabels}
          />
        </div>

        <div class="admin-form__field">
          <span>Labela dugmeta</span>
          <AdminRichTextField
            client:load
            name="promptLabel"
            initialValue={content.prompt.label}
            mode="inline"
            uploadUrl="/api/admin/media/upload"
            uploadFolder="pages/home"
            labels={richTextLabels}
          />
        </div>

        <div class="admin-form__field admin-form__field--full">
          <span>Tekst</span>
          <AdminRichTextField
            client:load
            name="promptCopy"
            initialValue={content.prompt.copy}
            uploadUrl="/api/admin/media/upload"
            uploadFolder="pages/home"
            labels={richTextLabels}
          />
        </div>
      </div>
    </div>
  </div>

  <div
    class="card"
    style="padding: 1.5rem;"
    data-section-preview
    data-section-preview-fragment="home-about"
  >
    <AdminBlockVisibilityToggle fragment="home-about" hidden={isBlockHidden("home-about")} />
    <AdminBlockBackgroundPicker fragment="home-about" value={getBlockBackgroundKey("home-about")} />
    <div class="page-grid">
      <div>
        <h2 style="margin: 0;">O terapeutu</h2>
        <p class="section-copy">Opis je objedinjeni rich text dokument sa paragrafima i listama.</p>
      </div>

      <div class="admin-form__grid">
        <div class="admin-form__field admin-form__field--full">
          <span>Naslov</span>
          <AdminRichTextField
            client:load
            name="aboutTitle"
            initialValue={content.about.title}
            mode="inline"
            uploadUrl="/api/admin/media/upload"
            uploadFolder="pages/home"
            labels={richTextLabels}
          />
        </div>

        <AdminMediaField
          client:load
          name="aboutImage"
          label="Slika"
          initialValue={content.about.image}
          uploadUrl="/api/admin/media/upload"
          uploadFolder="pages/home"
          uploadLabel="Dodaj sliku"
        />

        <div class="admin-form__field admin-form__field--full">
          <span>Opis</span>
          <AdminRichTextField
            client:load
            name="aboutBody"
            initialValue={content.about.body}
            uploadUrl="/api/admin/media/upload"
            uploadFolder="pages/home"
            labels={richTextLabels}
          />
        </div>

        <div class="admin-form__field">
          <span>Labela dugmeta</span>
          <AdminRichTextField
            client:load
            name="aboutLabel"
            initialValue={content.about.label}
            mode="inline"
            uploadUrl="/api/admin/media/upload"
            uploadFolder="pages/home"
            labels={richTextLabels}
          />
        </div>
      </div>
    </div>
  </div>

  <div
    class="card"
    style="padding: 1.5rem;"
    data-section-preview
    data-section-preview-fragment="home-services"
  >
    <AdminBlockVisibilityToggle fragment="home-services" hidden={isBlockHidden("home-services")} />
    <AdminBlockBackgroundPicker fragment="home-services" value={getBlockBackgroundKey("home-services")} />
    <div class="page-grid">
      <div>
        <h2 style="margin: 0;">Usluge</h2>
        <p class="section-copy">Opis sekcije i opisi kartica koriste rich text editor.</p>
      </div>

      <div class="admin-form__grid">
        <div class="admin-form__field">
          <span>Naslov sekcije</span>
          <AdminRichTextField
            client:load
            name="servicesTitle"
            initialValue={content.services.title}
            mode="inline"
            uploadUrl="/api/admin/media/upload"
            uploadFolder="pages/home"
            labels={richTextLabels}
          />
        </div>

        <div class="admin-form__field admin-form__field--full">
          <span>Opis sekcije</span>
          <AdminRichTextField
            client:load
            name="servicesCopy"
            initialValue={content.services.copy}
            uploadUrl="/api/admin/media/upload"
            uploadFolder="pages/home"
            labels={richTextLabels}
          />
        </div>

        <p class="section-copy admin-form__field--full">
          Statične kartice (bez linka). Sav tekst i slike se menjaju ovde.
        </p>
        {
          normalizedServiceItems.map((item, index) => (
            <div class="admin-section-group admin-form__field--full">
              <h3 style="margin: 0;">Kartica {index + 1}</h3>
              <div class="admin-form__grid">
                <label class="admin-form__field">
                  <span>Naslov</span>
                  <input
                    class="input-control"
                    name={`service${index + 1}Title`}
                    value={item.title}
                  />
                </label>

                <AdminMediaField
                  client:load
                  name={`service${index + 1}Image`}
                  label="Ikonica / slika"
                  initialValue={item.image}
                  uploadUrl="/api/admin/media/upload"
                  uploadFolder="pages/home"
                  uploadLabel="Dodaj sliku"
                />

                <div class="admin-form__field admin-form__field--full">
                  <span>Opis</span>
                  <AdminRichTextField
                    client:load
                    name={`service${index + 1}Copy`}
                    initialValue={item.copy}
                    uploadUrl="/api/admin/media/upload"
                    uploadFolder="pages/home"
                    labels={richTextLabels}
                  />
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div
    class="card"
    style="padding: 1.5rem;"
    data-section-preview
    data-section-preview-fragment="home-themes"
  >
    <AdminBlockVisibilityToggle fragment="home-themes" hidden={isBlockHidden("home-themes")} />
    <AdminBlockBackgroundPicker fragment="home-themes" value={getBlockBackgroundKey("home-themes")} />
    <div class="page-grid">
      <div>
        <h2 style="margin: 0;">Teme rada</h2>
        <p class="section-copy">Tri mesta. Biraš koju temu (sa stranice Psihoterapija) prikazuješ, njenu sliku i labelu linka.</p>
      </div>

      <div class="admin-form__grid">
        <div class="admin-form__field">
          <span>Naslov sekcije</span>
          <AdminRichTextField
            client:load
            name="themesTitle"
            initialValue={content.themes.title}
            mode="inline"
            uploadUrl="/api/admin/media/upload"
            uploadFolder="pages/home"
            labels={richTextLabels}
          />
        </div>

        <p class="section-copy admin-form__field--full">
          Naslov i opis teme dolaze sa stranice <strong>Psihoterapija</strong> (segment „Teme"). Sve teme vode na odgovarajuću temu na /psihoterapija/.
        </p>
        {
          content.themes.items.map((item, index) => {
            const currentTabIndex = item.themeTabIndex ?? index;
            return (
              <div class="admin-section-group admin-form__field--full">
                <h3 style="margin: 0;">Mesto {index + 1}</h3>
                <div class="admin-form__grid">
                  <label class="admin-form__field">
                    <span>Tema sa Psihoterapije</span>
                    <select class="input-control" name={`theme${index + 1}TabIndex`}>
                      {themeTabOptions.length === 0 ? (
                        <option value={String(index)} selected>
                          (Nema tema — dodaj ih na stranici Psihoterapija)
                        </option>
                      ) : (
                        themeTabOptions.map((option) => (
                          <option value={String(option.index)} selected={option.index === currentTabIndex}>
                            {option.label}
                          </option>
                        ))
                      )}
                    </select>
                  </label>

                  <label class="admin-form__field">
                    <span>Labela linka</span>
                    <input class="input-control" name={`theme${index + 1}Label`} value={item.label ?? ""} />
                  </label>

                  <AdminMediaField
                    client:load
                    name={`theme${index + 1}Image`}
                    label="Slika"
                    initialValue={item.image}
                    uploadUrl="/api/admin/media/upload"
                    uploadFolder="pages/home"
                    uploadLabel="Dodaj sliku"
                  />
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>

  <div
    class="card"
    style="padding: 1.5rem;"
    data-section-preview
    data-section-preview-fragment="home-reasons"
  >
    <AdminBlockVisibilityToggle fragment="home-reasons" hidden={isBlockHidden("home-reasons")} />
    <AdminBlockBackgroundPicker fragment="home-reasons" value={getBlockBackgroundKey("home-reasons")} />
    <div class="page-grid">
      <div>
        <h2 style="margin: 0;">Zašto Ikar</h2>
        <p class="section-copy">
          Opis sekcije i opisi razloga su rich text. Video ostaje URL ili upload.
        </p>
      </div>

      <div class="admin-form__grid">
        <div class="admin-form__field">
          <span>Naslov sekcije</span>
          <AdminRichTextField
            client:load
            name="reasonsTitle"
            initialValue={content.reasons.title}
            mode="inline"
            uploadUrl="/api/admin/media/upload"
            uploadFolder="pages/home"
            labels={richTextLabels}
          />
        </div>

        <div class="admin-form__field admin-form__field--full">
          <span>Opis sekcije</span>
          <AdminRichTextField
            client:load
            name="reasonsCopy"
            initialValue={content.reasons.copy}
            uploadUrl="/api/admin/media/upload"
            uploadFolder="pages/home"
            labels={richTextLabels}
          />
        </div>

        {
          content.reasons.items.map((item, index) => (
            <div class="admin-section-group admin-form__field--full">
              <h3 style="margin: 0;">Razlog {index + 1}</h3>
              <div class="admin-form__grid">
                <label class="admin-form__field">
                  <span>Naslov</span>
                  <input
                    class="input-control"
                    name={`reason${index + 1}Title`}
                    value={item.title}
                  />
                </label>

                <label class="admin-form__field">
                  <span>Labela linka</span>
                  <input
                    class="input-control"
                    name={`reason${index + 1}Label`}
                    value={item.label}
                  />
                </label>

                <div class="admin-form__field admin-form__field--full">
                  <span>Opis</span>
                  <AdminRichTextField
                    client:load
                    name={`reason${index + 1}Copy`}
                    initialValue={item.copy}
                    uploadUrl="/api/admin/media/upload"
                    uploadFolder="pages/home"
                    labels={richTextLabels}
                  />
                </div>
              </div>
            </div>
          ))
        }

        {/* Video plejer privremeno onemogucen — URL i labela su sakriveni, postojece vrednosti se cuvaju kroz hidden input. */}
        <input type="hidden" name="reasonsVideoUrl" value={content.reasons.videoUrl} />
        <input type="hidden" name="reasonsVideoLabel" value={content.reasons.videoLabel} />
        {/*
        <AdminMediaField
          client:load
          name="reasonsVideoUrl"
          label="Video URL ili otpremljen video"
          initialValue={content.reasons.videoUrl}
          uploadUrl="/api/admin/media/upload"
          uploadFolder="pages/home"
          accept={videoAccept}
          uploadLabel="Otpremi video"
          helpText="Možete ostaviti YouTube/Vimeo URL ili otpremiti direktan video fajl."
        />
        */}

        <AdminMediaField
          client:load
          name="reasonsVideoImage"
          label="Slika"
          initialValue={content.reasons.videoImage}
          uploadUrl="/api/admin/media/upload"
          uploadFolder="pages/home"
          uploadLabel="Dodaj sliku"
        />

        {/*
        <label class="admin-form__field">
          <span>Labela videa</span>
          <input
            class="input-control"
            name="reasonsVideoLabel"
            value={content.reasons.videoLabel}
          />
        </label>
        */}
      </div>
    </div>
  </div>

  <div
    class="card"
    style="padding: 1.5rem;"
    data-section-preview
    data-section-preview-fragment="home-booking"
  >
    <AdminBlockVisibilityToggle fragment="home-booking" hidden={isBlockHidden("home-booking")} />
    <AdminBlockBackgroundPicker fragment="home-booking" value={getBlockBackgroundKey("home-booking")} />
    <div class="page-grid">
      <div>
        <h2 style="margin: 0;">Zakazivanje</h2>
        <p class="section-copy">Opis sekcije je jedan rich text dokument.</p>
      </div>

      <div class="admin-form__grid">
        <div class="admin-form__field">
          <span>Naslov sekcije</span>
          <AdminRichTextField
            client:load
            name="bookingTitle"
            initialValue={content.booking.title}
            mode="inline"
            uploadUrl="/api/admin/media/upload"
            uploadFolder="pages/home"
            labels={richTextLabels}
          />
        </div>

        <div class="admin-form__field admin-form__field--full">
          <span>Opis sekcije</span>
          <AdminRichTextField
            client:load
            name="bookingCopy"
            initialValue={content.booking.copy}
            uploadUrl="/api/admin/media/upload"
            uploadFolder="pages/home"
            labels={richTextLabels}
          />
        </div>

        <label class="admin-form__field">
          <span>Labela iznad izbora formata</span>
          <input
            class="input-control"
            name="bookingFormatLabel"
            value={content.booking.formatLabel}
          />
        </label>

        <label class="admin-form__field">
          <span>Format 1</span>
          <input class="input-control" name="bookingFormat1" value={content.booking.formats[0] ?? ""} />
        </label>

        <label class="admin-form__field">
          <span>Format 2</span>
          <input class="input-control" name="bookingFormat2" value={content.booking.formats[1] ?? ""} />
        </label>

        <label class="admin-form__field">
          <span>Format 3</span>
          <input class="input-control" name="bookingFormat3" value={content.booking.formats[2] ?? ""} />
        </label>
      </div>
    </div>
  </div>

  <div
    class="card"
    style="padding: 1.5rem;"
    data-section-preview
    data-section-preview-fragment="home-blog"
  >
    <AdminBlockVisibilityToggle fragment="home-blog" hidden={isBlockHidden("home-blog")} />
    <AdminBlockBackgroundPicker fragment="home-blog" value={getBlockBackgroundKey("home-blog")} />
    <div class="page-grid">
      <div>
        <h2 style="margin: 0;">Blog sekcija</h2>
        <p class="section-copy">
          Opis sekcije je rich text, a fallback poruka ostaje običan tekst.
        </p>
      </div>

      <div class="admin-form__grid">
        <div class="admin-form__field">
          <span>Naslov sekcije</span>
          <AdminRichTextField
            client:load
            name="recentTitle"
            initialValue={content.recent.title}
            mode="inline"
            uploadUrl="/api/admin/media/upload"
            uploadFolder="pages/home"
            labels={richTextLabels}
          />
        </div>

        <div class="admin-form__field">
          <span>Labela dugmeta</span>
          <AdminRichTextField
            client:load
            name="recentLabel"
            initialValue={content.recent.label}
            mode="inline"
            uploadUrl="/api/admin/media/upload"
            uploadFolder="pages/home"
            labels={richTextLabels}
          />
        </div>

        <div class="admin-form__field admin-form__field--full">
          <span>Opis sekcije</span>
          <AdminRichTextField
            client:load
            name="recentCopy"
            initialValue={content.recent.copy}
            uploadUrl="/api/admin/media/upload"
            uploadFolder="pages/home"
            labels={richTextLabels}
          />
        </div>

        <label class="admin-form__field admin-form__field--full">
          <span>Poruka kada nema blog postova</span>
          <textarea class="input-control input-control--textarea" name="recentEmpty" rows={2}
            >{content.recent.empty}</textarea
          >
        </label>
      </div>
    </div>
  </div>

  <div class="admin-form__actions admin-form__actions--floating">
    <p class="admin-form__save-status" data-admin-form-submit-status aria-live="polite"></p>
    <button class="button-primary admin-form__fab" type="submit" data-admin-form-submit>
      Sačuvaj početnu stranu
    </button>
  </div>
</form>

<script>
  import { setupAdminFormExperience } from "@/features/admin/editor/admin-form.client";

  (() => {
    const init = () => {
      setupAdminFormExperience();
    };

    init();
    document.addEventListener("astro:page-load", init);
  })();
</script>
