---
import AdminIcon from "@/components/components/AdminIcon.astro";
import SeoHead from "@/components/components/SeoHead.astro";
import { getDictionary } from "@/features/i18n/translate";
import { submissionService } from "@/features/forms/services/submission.service";
import { adminConfig } from "@/lib/config/admin";
import "@/styles/global.css";
import "@/styles/admin.css";
import "@/styles/admin-shell.css";

type Crumb = { label: string; href?: string };

type Props = {
  title: string;
  description?: string;
  active?:
    | "dashboard"
    | "pages"
    | "blog"
    | "submissions"
    | "navigation"
    | "site-header"
    | "site-footer";
  breadcrumb?: Crumb[];
};

const dictionary = getDictionary("sr-latn");
const {
  title,
  description = dictionary.meta.admin.layoutDescription,
  active,
  breadcrumb = [],
} = Astro.props;

const submissions = await submissionService.listSubmissions().catch(() => []);
const newSubmissions = submissions.filter((s) => s.status === "new").length;

const base = adminConfig.basePath;
const nav: Array<{
  key: NonNullable<Props["active"]>;
  href: string;
  label: string;
  icon: string;
  badge?: number;
}> = [
  { key: "dashboard",    href: `${base}/`,             label: "Pregled",    icon: "dashboard" },
  { key: "pages",        href: `${base}/pages/`,       label: "Stranice",   icon: "pages" },
  { key: "blog",         href: `${base}/blog/`,        label: "Blog",       icon: "blog" },
  { key: "submissions",  href: `${base}/submissions/`, label: "Prijave",    icon: "inbox", badge: newSubmissions },
  { key: "navigation",   href: `${base}/navigation/`,  label: "Navigacija", icon: "nav" },
  { key: "site-header",  href: `${base}/site/header/`, label: "Header",     icon: "panelTop" },
  { key: "site-footer",  href: `${base}/site/footer/`, label: "Footer",     icon: "panelBottom" },
];

---
<!doctype html>
<html lang="sr-Latn-RS">
  <head>
    <SeoHead
      title={title}
      description={description}
      canonicalPath={Astro.url.pathname}
      locale="sr-latn"
    />
    <meta name="robots" content="noindex" />
  </head>
  <body class="admin-shell-v2">
    <header class="admin-mobile-bar" data-admin-mobile-bar>
      <button class="admin-mobile-bar__toggle" type="button" aria-label="Menu" data-admin-menu-toggle>
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="4" y1="7" x2="20" y2="7"/>
          <line x1="4" y1="12" x2="20" y2="12"/>
          <line x1="4" y1="17" x2="20" y2="17"/>
        </svg>
      </button>
      <a class="admin-mobile-bar__brand" href={`${base}/`}>
        <span class="admin-mobile-bar__mark">I</span>
        <span class="admin-mobile-bar__title">Ikar Studio</span>
      </a>
    </header>
    <div class="admin-backdrop" data-admin-backdrop aria-hidden="true"></div>
    <aside class="admin-sidebar" data-admin-sidebar>
      <a class="admin-sidebar__brand" href={`${base}/`}>
        <span class="admin-sidebar__mark">I</span>
        <span>
          <div class="admin-sidebar__brand-title">Ikar Studio</div>
          <div class="admin-sidebar__brand-sub">Admin panel</div>
        </span>
      </a>

      <nav class="admin-sidebar__nav" aria-label="Admin navigation">
        {nav.map((item) => (
          <a
            href={item.href}
            class:list={["admin-nav-item", active === item.key && "is-active"]}
          >
            <AdminIcon name={item.icon} />
            <span>{item.label}</span>
            {item.badge != null && item.badge > 0 ? (
              <span class="admin-nav-item__badge">{item.badge}</span>
            ) : null}
          </a>
        ))}
      </nav>

      <div class="admin-sidebar__foot">
        <div class="admin-sidebar__user">
          <div class="admin-sidebar__avatar">A</div>
          <div>
            <div class="admin-sidebar__user-name">Admin</div>
            <div class="admin-sidebar__user-sub">Ikar Studio</div>
          </div>
        </div>
        <div class="admin-sidebar__foot-actions">
          <a class="admin-foot-btn" href="/" target="_blank" rel="noreferrer">
            <AdminIcon name="external" /> Sajt
          </a>
          <form action="/api/admin/logout" method="post" style="flex:1;display:flex;">
            <button class="admin-foot-btn" type="submit" style="flex:1;">
              <AdminIcon name="logout" /> Odjava
            </button>
          </form>
        </div>
      </div>
    </aside>

    <div class="admin-main">
      <header class="admin-topbar">
        <nav class="admin-breadcrumb" aria-label="Breadcrumb">
          <a href={`${base}/`}>Admin</a>
          {breadcrumb.map((b) => (
            <>
              <span class="admin-breadcrumb__sep">/</span>
              {b.href ? (
                <a href={b.href}>{b.label}</a>
              ) : (
                <span class="admin-breadcrumb__active">{b.label}</span>
              )}
            </>
          ))}
        </nav>
      </header>

      <main class="admin-content">
        <slot />
      </main>
    </div>

    <script>
      (() => {
        const body = document.body;
        const sidebar = document.querySelector<HTMLElement>("[data-admin-sidebar]");
        const backdrop = document.querySelector<HTMLElement>("[data-admin-backdrop]");
        const toggle = document.querySelector<HTMLButtonElement>("[data-admin-menu-toggle]");
        if (!sidebar || !backdrop || !toggle) return;

        const open = () => {
          body.classList.add("admin-sidebar-open");
        };
        const close = () => {
          body.classList.remove("admin-sidebar-open");
        };

        toggle.addEventListener("click", () => {
          body.classList.contains("admin-sidebar-open") ? close() : open();
        });
        backdrop.addEventListener("click", close);
        // Close after tapping any nav link on mobile
        sidebar.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
          link.addEventListener("click", () => {
            if (window.matchMedia("(max-width: 64rem)").matches) close();
          });
        });
        // Close on Escape
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") close();
        });
      })();
    </script>
  </body>
</html>
