---
import { localizePath } from "@/features/i18n/locale";
import { getDictionary } from "@/features/i18n/translate";
import { pageContentService } from "@/features/page-content/services/page-content.service";
import { siteSettingsService } from "@/features/site-settings/services/site-settings.service";
import { siteConfig, type SiteLocale } from "@/lib/config/site";

type Props = {
  locale: SiteLocale;
};

const { locale } = Astro.props;
const dictionary = getDictionary(locale);
const contactContent = await pageContentService.getContactPageData(locale);
const settings = await siteSettingsService.get();

// Social links: managed centrally from Site settings (Kontakt stranica više ne doprinosi footer-u)
type SocialLink = { platform: string; label: string; href: string };
const allSocialLinks: SocialLink[] = (settings.footer.extraSocialLinks ?? []).filter(
  (link): link is SocialLink => Boolean(link.href && link.platform && link.label),
);

const galleryImages = contactContent.officeGallery.slice(0, 3);
const brandHeading = settings.footer.brandHeading || settings.brand.name || siteConfig.name;
const contactEyebrow = settings.footer.contactEyebrow || dictionary.footer.contactEyebrow;
// Footer currently has a dark background → pick the variant designed for dark
// surfaces (logoLight). Falls back to the header's light-variant logo, then to
// the legacy asset.
const footerLogo =
  settings.footer.logoLight ||
  settings.brand.logoLight ||
  "/legacy/images/Logo-White.svg";
const showFooterLogo = !settings.footer.hideLogo && Boolean(footerLogo);
const copyrightText =
  settings.footer.copyright || `© ${new Date().getFullYear()} ${brandHeading}. Sva prava zadržana.`;

// Render per-platform inline SVG icons
const PLATFORM_ICONS: Record<string, string> = {
  instagram:
    '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="3.75"/><circle cx="17.2" cy="6.8" r="1"/>',
  facebook:
    '<path d="M15 8h-2a1 1 0 0 0-1 1v2h3l-.5 3H12v6h-3v-6H7v-3h2V8.5A3.5 3.5 0 0 1 12.5 5H15v3z"/>',
  linkedin:
    '<rect x="3.5" y="3.5" width="17" height="17" rx="2"/><line x1="8" y1="10" x2="8" y2="17"/><circle cx="8" cy="7" r="0.6"/><path d="M12 17v-4.5a2 2 0 1 1 4 0V17"/><line x1="12" y1="10" x2="12" y2="17"/>',
  youtube:
    '<rect x="2.5" y="6" width="19" height="12" rx="3"/><polygon points="10,9 16,12 10,15" fill="currentColor" stroke="none"/>',
  tiktok:
    '<path d="M14 4v9a3 3 0 1 1-3-3"/><path d="M14 4c0 2 1.5 4 4 4"/>',
  twitter:
    '<path d="M22 5.8a8 8 0 0 1-2.4.7 4.2 4.2 0 0 0 1.8-2.3 8 8 0 0 1-2.6 1 4.2 4.2 0 0 0-7.1 3.8A11.9 11.9 0 0 1 3 4.8a4.2 4.2 0 0 0 1.3 5.6 4.2 4.2 0 0 1-1.9-.5v.1A4.2 4.2 0 0 0 5.8 14a4.2 4.2 0 0 1-1.9.1 4.2 4.2 0 0 0 3.9 2.9A8.4 8.4 0 0 1 2 18.7a11.9 11.9 0 0 0 6.4 1.9c7.7 0 12-6.4 12-11.9v-.5A8.5 8.5 0 0 0 22 5.8z"/>',
  x:
    '<path d="M4 4l16 16M20 4L4 20"/>',
  email:
    '<rect x="3" y="5" width="18" height="14" rx="2"/><polyline points="3,7 12,13 21,7"/>',
  website:
    '<circle cx="12" cy="12" r="9"/><line x1="3" y1="12" x2="21" y2="12"/><path d="M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>',
};
const iconFor = (platform: string) =>
  PLATFORM_ICONS[platform.toLowerCase().trim()] ??
  '<circle cx="12" cy="12" r="9"/><line x1="8" y1="12" x2="16" y2="12"/>';
const footerPrimaryLinks = [
  { label: dictionary.nav.home, href: localizePath(locale, "/") },
  { label: dictionary.nav.about, href: localizePath(locale, "/o-nama/") },
  { label: dictionary.nav.psychotherapy, href: localizePath(locale, "/psihoterapija/") },
  { label: dictionary.nav.blog, href: localizePath(locale, "/blog/") },
];
const footerSupportLinks = [
  { label: dictionary.nav.faq, href: localizePath(locale, "/pitanja/") },
  { label: dictionary.nav.contact, href: localizePath(locale, "/kontakt/") },
  { label: dictionary.nav.appointment, href: localizePath(locale, "/zakazivanje/") },
];
---

<footer class="section site-footer">
  <div class="footer-shell">
    <div class="container">
      <div class="footer-cta">
        <div class="footer-brand">
          <p class="eyebrow footer-eyebrow">{contactEyebrow}</p>
          <h2>{brandHeading}</h2>
        </div>
        <a class="appbar__cta" href={localizePath(locale, "/kontakt/")}>
          {dictionary.nav.contact}
        </a>
      </div>

      <div class="footer-main">
        <div class="footer-brand">
          {showFooterLogo && (
            <img
              class="footer-brand__logo"
              src={footerLogo}
              alt={brandHeading}
              loading="lazy"
              data-image-component
            />
          )}
          <div class="footer-contact-list">
            <a href={`mailto:${contactContent.email}`}>{contactContent.email}</a>
            <a href={`tel:${contactContent.phone.replace(/\s+/g, "")}`}
              >{contactContent.phone}</a
            >
          </div>
        </div>

        <div class="footer-sitemap">
          <p class="footer-section-title">{dictionary.footer.sitemapTitle}</p>
          <nav class="footer-sitemap__grid" aria-label={dictionary.a11y.footerNav}>
            <div class="footer-link-group">
              <p class="footer-link-group__title">{dictionary.footer.navigationTitle}</p>
              <div class="footer-nav">
                {footerPrimaryLinks.map((item) => <a href={item.href}>{item.label}</a>)}
              </div>
            </div>

            <div class="footer-link-group">
              <p class="footer-link-group__title">{dictionary.footer.supportTitle}</p>
              <div class="footer-nav">
                {footerSupportLinks.map((item) => <a href={item.href}>{item.label}</a>)}
              </div>
            </div>
          </nav>
        </div>

        <div class="footer-aside">
          <div class="footer-social">
            <p class="footer-section-title">{dictionary.footer.socialTitle}</p>
            {allSocialLinks.length === 0 ? (
              <p class="footer-social-empty">{dictionary.footer.instagramPlaceholder}</p>
            ) : (
              <div class="footer-social-list">
                {allSocialLinks.map((link) => (
                  <a
                    class="footer-social-link"
                    href={link.href}
                    target="_blank"
                    rel="noreferrer"
                    aria-label={link.label}
                  >
                    <span class="footer-social-link__icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" set:html={iconFor(link.platform)}></svg>
                    </span>
                    <span class="footer-social-link__copy">
                      <strong>{link.label}</strong>
                      <span>{link.href}</span>
                    </span>
                  </a>
                ))}
              </div>
            )}
          </div>

          <div class="footer-gallery" aria-hidden="true">
            {
              galleryImages.map((image) => (
                <img src={image} alt="" loading="lazy" data-image-component />
              ))
            }
          </div>
        </div>
      </div>

      <div class="footer-bottom">
        <span>{copyrightText}</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    display: block;
    padding: 0;
    margin-top: 0;
  }

  .container {
    width: min(calc(100% - 1.875rem), var(--container, 90rem));
    margin: 0 auto;
  }

  .footer-shell {
    width: 100%;
    padding: clamp(2rem, 4vw, 2.5rem) 0 0;
    color: rgba(255, 255, 255, 0.86);
    background:
      linear-gradient(145deg, rgba(9, 31, 32, 0.98), rgba(22, 60, 61, 0.92)),
      url("/legacy/images/6_1-p-800.jpeg") center / cover no-repeat;
    border: none;
    border-radius: 0;
  }

  .footer-shell :is(h2, p, strong, span) {
    color: inherit;
  }

  .footer-shell img {
    display: block;
    max-width: 100%;
  }

  .footer-brand h2 {
    margin: 0;
    color: #fff;
    font-family: "Castoro", Georgia, serif;
    font-size: clamp(2.2rem, 4vw, 3.35rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .footer-brand p,
  .footer-nav a,
  .footer-contact-list a,
  .footer-social-link__copy span {
    margin: 0;
    font-family: "Lexend", "Segoe UI", sans-serif;
    line-height: 1.6;
  }

  .footer-shell a:not(.appbar__cta) {
    text-decoration: none;
    transition:
      color 180ms ease,
      opacity 180ms ease,
      transform 180ms ease,
      box-shadow 200ms ease-in-out,
      filter 200ms ease-in-out;
  }

  .eyebrow {
    margin: 0 0 0.85rem;
    font-family: "Lexend", "Segoe UI", sans-serif;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.74rem;
  }

  .footer-cta,
  .footer-main {
    display: grid;
    gap: 1.5rem;
  }

  .footer-cta {
    align-items: center;
    grid-template-columns: minmax(0, 1fr) auto;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .footer-cta .appbar__cta {
    align-self: center;
    text-decoration: none;
  }

  .footer-eyebrow {
    color: rgba(255, 255, 255, 0.62);
  }

  .footer-main {
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr) minmax(17rem, 0.95fr);
    padding-top: 1.5rem;
    padding-bottom: 10px;
    align-items: start;
  }

  .footer-brand {
    display: grid;
    gap: 1rem;
  }

  .footer-brand__logo {
    height: 2.1rem;
    width: auto;
  }

  .footer-contact-list,
  .footer-nav {
    display: grid;
    gap: 0.75rem;
  }

  .footer-sitemap,
  .footer-aside,
  .footer-social,
  .footer-link-group,
  .footer-social-link__copy {
    display: grid;
    gap: 1rem;
  }

  .footer-sitemap__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.1rem;
  }

  .footer-section-title,
  .footer-link-group__title {
    margin: 0;
    color: rgba(255, 255, 255, 0.6);
    font-family: "Lexend", "Segoe UI", sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .footer-link-group__title {
    font-size: 0.74rem;
  }

  .footer-nav a,
  .footer-contact-list a {
    color: rgba(255, 255, 255, 0.72);
  }

  .footer-nav a:hover,
  .footer-contact-list a:hover {
    color: #fff;
  }

  .footer-gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .footer-social-link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.9rem;
    align-items: center;
    padding: 1rem 1.05rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.06);
  }

  .footer-social-link__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 0.9rem;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  .footer-social-link__icon svg {
    width: 1.35rem;
    height: 1.35rem;
  }

  .footer-social-link__copy {
    gap: 0.2rem;
  }

  .footer-social-link__copy strong {
    font-family: "Lexend", "Segoe UI", sans-serif;
    font-weight: 600;
  }

  .footer-gallery img {
    aspect-ratio: 1;
    width: 100%;
    object-fit: cover;
    border-radius: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  @media (max-width: 720px) {
    .site-footer {
      margin-top: 0;
    }

    .footer-main,
    .footer-cta {
      grid-template-columns: 1fr;
    }
  }

  /* Multiple social links list */
  .footer-social-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .footer-social-empty {
    margin: 0;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.55);
  }

  /* Bottom copyright */
  .footer-bottom {
    margin-top: 2rem;
    padding: 1rem 0 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.55);
    text-align: center;
  }
</style>
