---
import BaseLayout from "@/components/components/BaseLayout.astro";

type Props = {
  title: string;
  seoTitle: string;
  seoDescription: string;
  canonicalPath: string;
  publishedAt: Date;
};

const { title, seoTitle, seoDescription, canonicalPath, publishedAt } = Astro.props;
---

<BaseLayout title={seoTitle} description={seoDescription} canonicalPath={canonicalPath}>
  <section class="section">
    <div class="container">
      <div class="card" style="padding: clamp(1.5rem, 4vw, 3rem);">
        <div class="page-grid">
          <p class="eyebrow">
            {publishedAt.toLocaleDateString("sr-RS")}
          </p>
          <h1 class="blog-post-title" set:html={title} />
          <div class="prose-shell">
            <slot />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
