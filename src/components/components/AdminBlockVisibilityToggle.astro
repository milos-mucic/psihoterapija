---
type Props = {
  fragment: string;
  hidden: boolean;
  label?: string;
};

const { fragment, hidden, label = "Prikaži ovaj blok na sajtu" } = Astro.props;
const inputName = `blockHidden_${fragment}`;
---

<div class="admin-block-visibility" data-admin-block-visibility>
  <input type="hidden" name={inputName} value={hidden ? "1" : "0"} data-admin-block-hidden-value />
  <label class="admin-block-visibility__label">
    <input
      type="checkbox"
      class="admin-block-visibility__checkbox"
      data-admin-block-visibility-toggle
      checked={!hidden}
    />
    <span class="admin-block-visibility__track" aria-hidden="true">
      <span class="admin-block-visibility__thumb"></span>
    </span>
    <span class="admin-block-visibility__text">{label}</span>
    <span class="admin-block-visibility__state" data-admin-block-visibility-state>
      {hidden ? "Sakriveno" : "Prikazano"}
    </span>
  </label>
</div>

<style>
  .admin-block-visibility {
    display: flex;
    align-items: center;
    margin-bottom: 1rem;
    padding: 0.7rem 0.9rem;
    border-radius: 0.6rem;
    background: rgba(22, 60, 61, 0.05);
    border: 1px solid rgba(22, 60, 61, 0.1);
  }

  .admin-block-visibility__label {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    cursor: pointer;
    user-select: none;
    font-size: 0.92rem;
    color: var(--foreground);
  }

  .admin-block-visibility__checkbox {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    width: 0;
    height: 0;
  }

  .admin-block-visibility__track {
    position: relative;
    display: inline-block;
    width: 2.4rem;
    height: 1.35rem;
    border-radius: 999px;
    background: rgba(22, 60, 61, 0.25);
    transition: background-color 160ms ease;
    flex: 0 0 auto;
  }

  .admin-block-visibility__thumb {
    position: absolute;
    top: 0.15rem;
    left: 0.15rem;
    width: 1.05rem;
    height: 1.05rem;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 2px 4px rgba(16, 47, 48, 0.18);
    transition: transform 160ms ease;
  }

  .admin-block-visibility__checkbox:checked ~ .admin-block-visibility__track {
    background: var(--primary);
  }

  .admin-block-visibility__checkbox:checked ~ .admin-block-visibility__track .admin-block-visibility__thumb {
    transform: translateX(1.05rem);
  }

  .admin-block-visibility__checkbox:focus-visible ~ .admin-block-visibility__track {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .admin-block-visibility__text {
    font-weight: 500;
  }

  .admin-block-visibility__state {
    margin-left: 0.4rem;
    padding: 0.12rem 0.5rem;
    border-radius: 999px;
    background: rgba(22, 60, 61, 0.08);
    color: var(--primary);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
</style>

<script>
  (() => {
    const init = () => {
      document.querySelectorAll("[data-admin-block-visibility]").forEach((wrapper) => {
        if (!(wrapper instanceof HTMLElement) || wrapper.dataset.bound === "true") {
          return;
        }

        const hiddenInput = wrapper.querySelector("[data-admin-block-hidden-value]");
        const toggle = wrapper.querySelector("[data-admin-block-visibility-toggle]");
        const stateLabel = wrapper.querySelector("[data-admin-block-visibility-state]");

        if (
          !(hiddenInput instanceof HTMLInputElement) ||
          !(toggle instanceof HTMLInputElement)
        ) {
          return;
        }

        const sync = () => {
          const isHidden = !toggle.checked;
          hiddenInput.value = isHidden ? "1" : "0";

          if (stateLabel instanceof HTMLElement) {
            stateLabel.textContent = isHidden ? "Sakriveno" : "Prikazano";
          }

          hiddenInput.dispatchEvent(new Event("change", { bubbles: true }));
          hiddenInput.dispatchEvent(new Event("input", { bubbles: true }));
        };

        toggle.addEventListener("change", sync);
        wrapper.dataset.bound = "true";
      });
    };

    init();
    document.addEventListener("astro:page-load", init);
  })();
</script>
