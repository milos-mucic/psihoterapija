---
import { AdminMediaField } from "@/components/components/AdminMediaField";
import { AdminRichTextField } from "@/components/components/AdminRichTextField";
import AdminToggleField from "@/components/components/AdminToggleField.astro";
import type { ManagedPageEditorField } from "@/features/page-content/admin/managed-page-editor.config";
import { isTechnicalFieldName } from "@/features/page-content/admin/technical-fields";

type Props = {
  field: ManagedPageEditorField;
  uploadFolder: string;
  richTextLabels: Record<string, string>;
};

const { field, uploadFolder, richTextLabels } = Astro.props;
const fieldClass =
  field.kind === "media"
    ? undefined
    : field.full
      ? "admin-form__field admin-form__field--full"
      : "admin-form__field";

// Promote text/textarea fields to RTF unless they look "technical" (SEO, URL, email, alt, label, slug, placeholder).
// Technical fields go into HTML attributes or constrained UI elements where HTML markup would break things.
const forceRich = field.kind === "text" && field.rich === true;
const promoteText =
  field.kind === "text" && (forceRich || !isTechnicalFieldName(field.name));
const promoteTextarea =
  field.kind === "textarea" && !isTechnicalFieldName(field.name);
const renderAsRichText =
  field.kind === "richText" || promoteText || promoteTextarea;
const richTextMode: "full" | "inline" = promoteText ? "inline" : "full";
---

{
  renderAsRichText && field.kind !== "media" ? (
    <div class={fieldClass}>
      <span>{field.label}</span>
      <AdminRichTextField
        client:load
        name={field.name}
        initialValue={field.value}
        uploadUrl="/api/admin/media/upload"
        uploadFolder={uploadFolder}
        labels={richTextLabels}
        mode={richTextMode}
      />
    </div>
  ) : field.kind === "text" ? (
    <label class={fieldClass}>
      <span>{field.label}</span>
      <input class="input-control" name={field.name} value={field.value} />
    </label>
  ) : field.kind === "textarea" ? (
    <label class={fieldClass}>
      <span>{field.label}</span>
      <textarea
        class="input-control input-control--textarea"
        name={field.name}
        rows={field.rows ?? 2}
      >
        {field.value}
      </textarea>
    </label>
  ) : field.kind === "toggle" ? (
    <div class={fieldClass}>
      <AdminToggleField name={field.name} label={field.label} value={field.value} />
    </div>
  ) : (
    <AdminMediaField
      client:load
      name={field.name}
      label={field.label}
      initialValue={field.value}
      uploadUrl="/api/admin/media/upload"
      uploadFolder={uploadFolder}
      accept={field.accept}
      helpText={field.helpText}
      uploadLabel={field.uploadLabel}
    />
  )
}
