---
import SubmissionForm from "@/components/components/SubmissionForm.astro";

type Props = {
  labels: {
    name: string;
    email: string;
    phone: string;
    message: string;
    formatLabel: string;
    chooseOption: string;
    submitContact: string;
    success: string;
    error: string;
  };
};

const { labels } = Astro.props;
---

<SubmissionForm type="contact" submitLabel={labels.submitContact} labels={labels} />
